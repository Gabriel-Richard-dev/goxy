# Copie para .env e preencha. Nunca versionar o .env.
AI_PROXY_API_KEY=            # gw-tok-... (token do evento)
GOXYS_LLM_MODEL=latest
GOXYS_LLM_FAST_MODEL=glm-5.3-flash

TELEGRAM_BOT_TOKEN=          # @BotFather
TELEGRAM_APPROVERS_CHAT_ID=  # chat/grupo dos supervisores (aprovações)

SLACK_BOT_TOKEN=             # xoxb-...
SLACK_APP_TOKEN=             # xapp-... (Socket Mode ligado)
SLACK_APPROVALS_CHANNEL=     # ex.: C0123456789

GOXYS_STEP_DELAY=0.8         # ritmo da linha do tempo na demo
GOXYS_APPROVAL_SLA_S=1800

GOXYS_PUBLIC_URL=            # em produção: https://seu-dominio (usado na assinatura do WhatsApp)

TWILIO_ACCOUNT_SID=          # AC... (WhatsApp via Twilio)
TWILIO_AUTH_TOKEN=           # valida a assinatura do webhook
TWILIO_API_KEY_SID=          # SK... (envio pela API REST)
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
